---
const pathname = Astro.url.pathname;

const activePage =
  pathname === "/"
    ? "home"
    : pathname.startsWith("/case-studies")
      ? "cases"
      : pathname.startsWith("/team")
        ? "team"
        : pathname.startsWith("/about")
          ? "about"
          : "";
---

<header>
  <nav aria-label="Main navigation">
    <a href="/" class="logo">
      Ask<span>Experts</span>
    </a>

    <ul>
      <li>
        <a href="/" class={activePage === "home" ? "active" : ""}> Home </a>
      </li>

      <li>
        <a
          href="/case-studies/taxes-and-efficiency"
          class={activePage === "cases" ? "active" : ""}
        >
          Case Studies
        </a>
      </li>

      <li>
        <a href="/team" class={activePage === "team" ? "active" : ""}> Team </a>
      </li>

      <li>
        <a href="/about" class={activePage === "about" ? "active" : ""}>
          About
        </a>
      </li>
    </ul>

    <button class="login-button" type="button" popovertarget="login-panel">
      Login
    </button>

    <div id="login-panel" class="login-panel" popover>
      <h2>Dashboard Login</h2>

      <form>
        <label for="login-email">Email address</label>

        <input
          id="login-email"
          name="email"
          type="email"
          autocomplete="email"
        />

        <label for="login-password">Password</label>

        <input
          id="login-password"
          name="password"
          type="password"
          autocomplete="current-password"
        />

        <button class="dashboard-button" type="submit">
          Go to dashboard
        </button>
      </form>
    </div>
  </nav>
</header>

<style>
  header {
    background: var(--color-neutrals-900);
    color: var(--color-neutrals-50);
  }

  nav {
    max-width: 1200px;
    margin-inline: auto;
    padding: var(--space-4) var(--space-8);

    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-8);
  }

  .logo {
    color: var(--color-neutrals-50);
    text-decoration: none;
    font-weight: var(--font-weight-bold);
    font-size: var(--space-5);
    white-space: nowrap;
  }

  .logo span {
    color: var(--color-yellow-500);
  }

  ul {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-8);

    margin: 0;
    padding: 0;

    list-style: none;
  }

  nav a {
    color: var(--color-neutrals-50);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--color-yellow-500);
  }

  /* Streg under aktiv side */

  ul a {
    display: block;

    padding-block: var(--space-2);

    border-bottom: 3px solid transparent;
  }

  ul a.active {
    border-bottom-color: var(--color-yellow-500);
  }

  /* Login knappen */

  .login-button {
    anchor-name: --login-button;

    border: 0;
    border-radius: 999px;

    padding: var(--space-2) var(--space-5);

    background: var(--color-neutrals-50);
    color: var(--color-neutrals-900);

    font: inherit;

    cursor: pointer;
  }

  /* Login panel */

  .login-panel {
    width: min(300px, calc(100vw - 32px));
    box-sizing: border-box;

    padding: 24px;

    border: 0;
    border-radius: 12px;

    background: var(--color-neutrals-50);
    color: var(--color-neutrals-900);

    box-shadow: 0 12px 30px rgb(0 0 0 / 0.2);
  }

  .login-panel h2 {
    margin: 0 0 24px;

    font-size: 1.4rem;
    line-height: 1.2;
  }

  .login-panel form {
    display: flex;
    flex-direction: column;
  }

  .login-panel label {
    margin-bottom: 6px;

    font-size: 0.75rem;
    font-weight: var(--font-weight-semibold);
  }

  .login-panel input {
    width: 100%;
    box-sizing: border-box;

    margin-bottom: 16px;
    padding: 10px 12px;

    border: 1px solid #d8d8d8;
    border-radius: 999px;

    background: var(--color-neutrals-50);
    color: var(--color-neutrals-900);

    font: inherit;
  }

  .login-panel input:focus {
    outline: 2px solid var(--color-yellow-500);
    outline-offset: 2px;
  }

  .dashboard-button {
    width: 100%;

    margin-top: 4px;
    padding: 11px 16px;

    border: 0;
    border-radius: 999px;

    background: var(--color-yellow-500);
    color: var(--color-neutrals-900);

    font: inherit;
    font-weight: var(--font-weight-bold);

    cursor: pointer;
  }

  /* Fallback:
     Hvis browseren ikke understøtter Anchor Positioning,
     åbner loginboksen midt på skærmen.
  */

  .login-panel:popover-open {
    position: fixed;

    inset: 50% auto auto 50%;

    margin: 0;

    transform: translate(-50%, -50%);
  }

  /* Hvis Anchor Positioning understøttes i browser, placeres loginboksen under Login knappen.
  */

  @supports (position-anchor: --login-button) {
    .login-panel:popover-open {
      position: fixed;

      position-anchor: --login-button;

      top: anchor(bottom);
      right: anchor(right);
      bottom: auto;
      left: auto;

      margin-top: 12px;

      transform: none;
    }
  }

  /* Tablet */

  @media (max-width: 800px) {
    nav {
      gap: var(--space-5);
    }

    ul {
      gap: var(--space-4);
    }
  }

  /* Mobil */

  @media (max-width: 700px) {
    nav {
      grid-template-columns: 1fr auto;

      padding: var(--space-4) var(--space-5);

      gap: var(--space-3) var(--space-4);
    }

    .logo {
      grid-column: 1;
      grid-row: 1;

      font-size: 1rem;
    }

    .login-button {
      grid-column: 2;
      grid-row: 1;

      padding: var(--space-2) var(--space-4);
    }

    ul {
      grid-column: 1 / -1;
      grid-row: 2;

      width: 100%;

      justify-content: flex-start;

      gap: var(--space-5);

      overflow-x: auto;

      scrollbar-width: none;
    }

    ul::-webkit-scrollbar {
      display: none;
    }

    ul a {
      padding-block: var(--space-2);

      font-size: var(--font-size-sm);

      white-space: nowrap;
    }
  }
</style>
