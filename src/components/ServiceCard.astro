---
const { service } = Astro.props;
import ArrowRight from "@icons/arrow--right.svg";
---

<article class="service-card">
  <h2>{service.title}</h2>

  <p>{service.description}</p>

  <a href="#0">
    {service.buttonText}
    <ArrowRight stroke-width={2.5} />
  </a>
</article>

<style>
  .service-card {
    background: var(--color-blue-700-transparent);
    color: var(--color-on-surface-elevated);

    padding: 2rem;
    border: 1px solid var(--color-neutrals-700);
    border-radius: 20px;

    height: 100%;
    box-sizing: border-box;

    display: flex;
    flex-direction: column;
  }

  .service-card h2 {
    margin: 0 0 var(--space-3);

    color: var(--color-on-surface-elevated);

    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-bold);
    line-height: 1.2;
  }

  .service-card p {
    margin: 0;

    color: var(--color-on-surface-elevated);

    line-height: 1.5;
  }

  .service-card a {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;

    gap: var(--space-3);

    margin-top: auto;
    padding-top: var(--space-8);

    color: var(--color-action);

    font-weight: var(--font-weight-bold);
  }

  .service-card a :global(svg) {
    width: 16px;
    height: 16px;
  }

  @media (max-width: 700px) {
    .service-card {
      padding: var(--space-5);
    }

    .service-card a {
      padding-top: var(--space-5);
    }
  }
</style>
