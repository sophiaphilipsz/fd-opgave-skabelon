<style>
  @layer components {
    article {
      background: var(--color-blue-700-transparent);
      color: var(--color-on-surface-elevated);

      padding: var(--space-8);
      border-radius: 20px;
      border: 1px solid var(--color-neutrals-700);

      height: 100%;
    }

    h2 {
      /* Luft mellem titel og brødtekst */
      margin: 0 0 var(--space-4) 0;
    }

    p {
      margin: 0 0 var(--space-8) 0;
    }

    a {
      display: inline-flex;
      align-items: center;
      gap: 1ch;

      color: var(--color-action);
      font-weight: bold;

      svg {
        inline-size: 16px;
      }
    }
  }
</style>