---
import { Image } from "astro:assets";
import Services from "./Services.astro";
import CEOImage from "@assets/images/ceo.webp";
---

<section class="hero">
  <div class="hero-main">
    <div class="hero-content">
      <h1>
        Empowering Your<br />
        Business Growth
      </h1>

      <p>
        Discover tailored strategies and expert insights to take your business
        to the next level. Let us help you navigate challenges and achieve
        sustainable success.
      </p>

      <div class="hero-buttons">
        <a href="#" class="button-primary">Book a Meeting</a>
        <a href="#" class="button-secondary">Learn More →</a>
      </div>
    </div>

    <div class="hero-image">
      <Image src={CEOImage} alt="CEO" />
    </div>
  </div>

  <div class="services-wrapper">
    <Services />
  </div>
</section>

<style>
  @layer components {
    .hero {
      position: relative;
      width: 100%;

      background-color: var(--color-neutrals-900);
      color: var(--color-neutrals-50);

      margin-bottom: calc(var(--space-20) + var(--space-20));
    }

    .hero-main {
      width: min(100% - 4rem, 1100px);
      min-height: 600px;

      margin-inline: auto;

      display: grid;
      grid-template-columns: 0.8fr 1.2fr;
      align-items: stretch;
      gap: var(--space-8);
    }

    .hero-content {
      display: flex;
      flex-direction: column;
      justify-content: center;

      padding-left: var(--space-8);
      padding-bottom: var(--space-16);
    }

    .hero-content h1 {
      max-width: 430px;

      margin: 0 0 var(--space-5);

      font-size: var(--font-size-2xl);
      font-weight: var(--font-weight-bold);
      line-height: 1.05;
    }

    .hero-content p {
      max-width: 410px;

      margin: 0 0 var(--space-8);

      color: var(--color-neutrals-400);

      line-height: 1.5;
    }

    .hero-buttons {
      display: flex;
      align-items: center;

      gap: var(--space-3);
    }

    .button-primary,
    .button-secondary {
      display: inline-flex;
      align-items: center;
      justify-content: center;

      padding: 0.7rem var(--space-5);

      border-radius: 2rem;

      text-decoration: none;
    }

    .button-primary {
      background-color: var(--color-yellow-500);
      color: var(--color-neutrals-900);
    }

    .button-secondary {
      border: 1px solid var(--color-neutrals-50);

      color: var(--color-neutrals-50);
    }

    .hero-image {
      min-width: 0;
      height: 100%;
    }

    .hero-image :global(img) {
      display: block;

      width: 100%;
      height: 100%;
      min-height: 600px;

      object-fit: cover;
      object-position: center;
    }

    .services-wrapper {
      position: absolute;
      z-index: 2;

      left: 50%;

      /* Boksene lidt længere op */
      bottom: var(--space-4);

      width: min(100% - 4rem, 900px);

      transform: translate(-50%, 50%);
    }

    /* Tablet */

    @media (max-width: 900px) {
      .hero-main {
        width: min(100% - 3rem, 760px);

        grid-template-columns: 1fr 1.1fr;
      }

      .hero-content {
        padding-left: 0;
      }

      .services-wrapper {
        width: min(100% - 3rem, 720px);
      }
    }

    /* Mobil */

    @media (max-width: 700px) {
      .hero {
        margin-bottom: 0;
      }

      .hero-main {
        width: 100%;
        min-height: 0;

        grid-template-columns: 1fr;
      }

      .hero-content {
        padding: var(--space-16) var(--space-5);
      }

      .hero-content h1 {
        font-size: var(--font-size-2xl);
      }

      .hero-content p {
        margin-bottom: var(--space-8);
      }

      .hero-image {
        height: auto;
      }

      .hero-image :global(img) {
        width: 100%;
        height: auto;
        min-height: 0;
      }

      .hero-buttons {
        flex-wrap: wrap;
      }

      .services-wrapper {
        position: relative;

        left: auto;
        bottom: auto;

        width: 100%;

        transform: none;
      }
    }
  }
</style>
