---
import { getTeamMembers } from "@lib/api";
import { Image } from "astro:assets";
import Layout from "@layouts/Layout.astro";
import Newsletter from "@components/Newsletter.astro";
import Footer from "@components/Footer.astro";

import InstagramIcon from "../../icons/instagram.svg";
import FacebookIcon from "../../icons/facebook.svg";

const team = await getTeamMembers();
---

<Layout>
  <main class="team-page">
    <section class="team-hero">
      <p class="eyebrow">TEAM</p>

      <h1>
        <span>The Consultants</span>
      </h1>

      <p class="intro">
        Our success stems from the synergy between dedicated teams and our
        valued clients. We prioritize a company culture that fosters exceptional
        productivity, ensures customer satisfaction.
      </p>
    </section>

    <section class="team-section">
      <div class="team-intro">
        <div>
          <h2>Meet Our Great Team</h2>

          <p>
            Welcome to our amazing team! We are a group of passionate
            individuals dedicated to excellence and innovation. Each member
            brings unique skills and experiences, working together to achieve
            our goals. Join us in our mission of creating projects and create
            lasting impacts.
          </p>
        </div>

        <a href="#team-grid" class="team-button"> Join our team </a>
      </div>

      <div class="team-grid" id="team-grid">
        {
          team.map((employee) => (
            <article class="team-card">
              <a
                href={`/team/${employee.slug}`}
                class="team-image-link"
                aria-label={`Read more about ${employee.name}`}
              >
                <!-- View Transition mellem teamoversigt og medarbejderside -->
                <div
                  class="team-image"
                  style={`view-transition-name: team-image-${employee.slug}`}
                >
                  <Image
                    src={employee.image.src}
                    alt={employee.image.alt}
                    width={employee.image.width}
                    height={employee.image.height}
                  />

                  <span class="team-role">{employee.title}</span>
                </div>
              </a>

              <h3 style={`view-transition-name: team-name-${employee.slug}`}>
                <a href={`/team/${employee.slug}`}>{employee.name}</a>
              </h3>

              <p class="team-description">{employee.description}</p>

              <div class="social-links">
                {employee.social_links?.map((social) => (
                  <a
                    href={social.url}
                    aria-label={`${employee.name} on ${social.platform}`}
                  >
                    <img
                      src={
                        social.platform === "instagram"
                          ? InstagramIcon.src
                          : FacebookIcon.src
                      }
                      alt=""
                    />
                  </a>
                ))}
              </div>
            </article>
          ))
        }
      </div>
    </section>
  </main>

  <Newsletter />
  <Footer />
</Layout>

<style>
  .team-page {
    background: var(--color-surface-primary);
    color: var(--color-text);
  }

  .team-hero {
    background: var(--color-surface-secondary);
    text-align: center;
    padding: var(--space-16) var(--space-4) var(--space-20);
  }

  .eyebrow {
    margin: 0 0 var(--space-2);
    font-size: var(--font-size-sm);
    text-transform: uppercase;
    letter-spacing: 0.15em;
  }

  .team-hero h1 {
    margin: 0;
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-bold);
  }

  /* Gul streg under overskriften */
  .team-hero h1 span {
    display: inline-block;
    border-bottom: 4px solid var(--color-action);
    line-height: 1.1;
  }

  .intro {
    max-width: 600px;
    margin: var(--space-5) auto 0;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .team-section {
    width: min(100% - 2rem, 960px);
    margin-inline: auto;
    padding-block: var(--space-16);
  }

  .team-intro {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: var(--space-8);
    margin-bottom: var(--space-10);
  }

  .team-intro > div {
    max-width: 620px;
  }

  .team-intro h2 {
    margin: 0 0 var(--space-3);
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-bold);
  }

  .team-intro p {
    margin: 0;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .team-button {
    flex-shrink: 0;
    display: inline-block;
    padding: var(--space-3) var(--space-5);
    border-radius: 999px;
    background: var(--color-ui-primary);
    color: var(--color-on-ui-primary);
    text-decoration: none;
    font-size: var(--font-size-sm);
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-10) var(--space-5);
  }

  .team-card {
    text-align: center;
  }

  .team-image-link {
    display: block;
    text-decoration: none;
  }

  .team-image {
    position: relative;
    overflow: hidden;
    border-radius: 8px;
    aspect-ratio: 1 / 1.08;
  }

  .team-image :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .team-role {
    position: absolute;
    right: var(--space-2);
    bottom: var(--space-2);
    padding: 0.3rem 0.65rem;
    border-radius: 999px;
    background: var(--color-ui-primary);
    color: var(--color-on-ui-primary);
    font-size: 0.65rem;
    line-height: 1;
  }

  .team-card h3 {
    margin: var(--space-3) 0 var(--space-2);
    font-size: 1rem;
    font-weight: var(--font-weight-bold);
  }

  .team-card h3 a {
    color: var(--color-text);
    text-decoration: none;
  }

  .team-description {
    margin: 0 auto;
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    line-height: 1.5;
    max-width: 280px;
  }

  .social-links {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }

  .social-links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
  }

  .social-links img {
    display: block;
    width: 14px;
    height: 14px;
  }

  /* tablet*/

  @media (max-width: 800px) {
    .team-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .team-intro {
      align-items: start;
    }
  }

  /* mobil */

  @media (max-width: 600px) {
    .team-hero {
      padding-block: var(--space-10);
    }

    .team-section {
      padding-block: var(--space-10);
    }

    .team-intro {
      flex-direction: column;
      align-items: start;
    }

    .team-grid {
      grid-template-columns: 1fr;
    }

    .team-card {
      max-width: 360px;
      width: 100%;
      margin-inline: auto;
    }
  }
</style>
