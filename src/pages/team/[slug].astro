---
// @ts-nocheck
import { getTeamMembers } from "@lib/api";
import { Image } from "astro:assets";
import Layout from "@layouts/Layout.astro";
import Newsletter from "@components/Newsletter.astro";
import Footer from "@components/Footer.astro";

export async function getStaticPaths() {
  const team = await getTeamMembers();

  return team.map((employee) => ({
    params: { slug: employee.slug },
    props: { employee },
  }));
}

const { employee } = Astro.props;
---

<Layout>
  <main class="employee-page">
    <section class="employee-section">
      <a href="/team" class="back-button"> ← Back to team </a>

      <div class="employee-grid">
        <div class="employee-visual">
          <!-- Samme navn bruges på teamoversigten, så billedet kan overgå mellem siderne -->
          <div
            class="image-wrapper"
            style={`view-transition-name: team-image-${employee.slug}`}
          >
            <Image
              src={employee.image.src}
              alt={employee.image.alt}
              width={employee.image.width}
              height={employee.image.height}
            />
          </div>

          <div class="social-links">
            {
              employee.social_links?.map((social) => (
                <a
                  href={social.url}
                  aria-label={`${employee.name} on ${social.platform}`}
                >
                  <img
                    src={`/src/icons/${social.icon}.svg`}
                    alt=""
                    aria-hidden="true"
                  />
                </a>
              ))
            }
          </div>
        </div>

        <div class="employee-content">
          <h1 style={`view-transition-name: team-name-${employee.slug}`}>
            {employee.name}
          </h1>

          <p class="employee-title">
            {employee.title}
          </p>

          <p class="employee-description">
            {employee.description_long}
          </p>

          <div class="employee-divider"></div>

          <div class="experience">
            <h2>Past experience</h2>

            <p>
              {employee.past_experience}
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<Newsletter />
<Footer />

<style>
  .employee-page {
    background: var(--color-surface-primary);
    color: var(--color-text);
  }

  .employee-section {
    width: min(100% - 2rem, 960px);
    margin-inline: auto;

    padding-top: var(--space-5);
    padding-bottom: var(--space-16);
  }

  .back-button {
    display: inline-flex;
    align-items: center;

    padding: var(--space-2) var(--space-4);

    /* Mere mellemrum mellem knappen og indholdet */
    margin-bottom: var(--space-16);

    background: var(--color-ui-primary);
    color: var(--color-on-ui-primary);

    border-radius: 999px;

    font-size: var(--font-size-sm);
    text-decoration: none;
  }

  .employee-grid {
    display: grid;

    /* Lidt større plads til billedet */
    grid-template-columns: 350px 440px;

    justify-content: center;
    align-items: start;

    gap: var(--space-16);
  }

  .employee-visual {
    position: relative;
  }

  .image-wrapper {
    position: relative;

    width: 350px;

    /* Billedet ligger foran den grønne firkant */
    isolation: isolate;
  }

  /* den grønne firkant bag billedet */

  .image-wrapper::before {
    content: "";

    position: absolute;

    width: 145px;
    height: 105px;

    top: -25px;
    left: -35px;

    background: var(--color-ui-secondary);

    border-radius: 10px;

    z-index: -1;
  }

  .image-wrapper :global(img) {
    display: block;

    width: 350px;
    height: 370px;

    object-fit: cover;

    border-radius: 8px;
  }

  .social-links {
    display: flex;
    justify-content: center;
    align-items: center;

    gap: var(--space-3);

    margin-top: var(--space-3);
  }

  .social-links a {
    display: flex;
    align-items: center;
    justify-content: center;

    color: var(--color-text);

    text-decoration: none;
  }

  .social-links img {
    display: block;

    width: 20px;
    height: 20px;
  }

  .employee-content {
    width: 440px;

    padding-top: var(--space-2);
  }

  .employee-content h1 {
    margin: 0;

    color: var(--color-text);

    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-bold);

    line-height: 1.1;
  }

  .employee-title {
    margin-top: var(--space-2);
    margin-bottom: var(--space-5);

    color: var(--color-text-muted);

    font-size: var(--font-size-sm);
  }

  .employee-description {
    margin: 0;

    color: var(--color-text-muted);

    font-size: var(--font-size-sm);
    line-height: 1.6;
  }

  .employee-divider {
    width: 100%;
    height: 1px;

    margin-top: var(--space-5);
    margin-bottom: var(--space-5);

    background: var(--color-surface-tertiary);
  }

  .experience h2 {
    margin: 0 0 var(--space-4);

    color: var(--color-text);

    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-bold);

    line-height: 1.2;
  }

  .experience p {
    margin: 0;

    color: var(--color-text-muted);

    font-size: var(--font-size-sm);
    line-height: 1.6;
  }

  /* tablet */

  @media (max-width: 900px) {
    .employee-section {
      width: min(100% - 2rem, 720px);
    }

    .employee-grid {
      grid-template-columns: minmax(260px, 350px) 1fr;

      gap: var(--space-8);
    }

    .image-wrapper {
      width: 100%;
    }

    .image-wrapper :global(img) {
      width: 100%;
      height: auto;

      aspect-ratio: 350 / 370;

      object-fit: cover;
    }

    .employee-content {
      width: 100%;
    }
  }

  /* mobil */

  @media (max-width: 650px) {
    .employee-section {
      padding-top: var(--space-5);
      padding-bottom: var(--space-10);
    }

    .back-button {
      margin-bottom: var(--space-10);
    }

    .employee-grid {
      grid-template-columns: 1fr;

      gap: var(--space-10);
    }

    .employee-visual {
      width: min(100%, 350px);

      margin-inline: auto;
    }

    .employee-content {
      width: 100%;

      padding-top: 0;
    }

    .image-wrapper::before {
      width: 120px;
      height: 90px;

      top: -20px;
      left: -15px;
    }
  }
</style>
